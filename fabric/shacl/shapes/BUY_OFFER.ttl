@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fabric: <http://smartchaindb.org/fabric#> .

fabric:BuyOfferShape a sh:NodeShape ;
    sh:targetClass fabric:BUY_OFFER ;
    sh:property [
        sh:path fabric:operation ;
        sh:hasValue "BUY_OFFER" ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "operation must be BUY_OFFER" ;
    ] ;
    sh:property [
        sh:path fabric:offerId ;
        sh:datatype xsd:string ; sh:minLength 1 ;
        sh:minCount 1 ;
        sh:message "offerId is required" ;
    ] ;
    sh:property [
        sh:path fabric:advId ;
        sh:datatype xsd:string ; sh:minLength 1 ;
        sh:minCount 1 ;
        sh:message "advId is required" ;
    ] ;
    sh:property [
        sh:path fabric:buyer ;
        sh:datatype xsd:string ; sh:minLength 1 ;
        sh:minCount 1 ;
        sh:message "buyer is required" ;
    ] ;
    sh:property [
        sh:path fabric:amount ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]+(\\.[0-9]{1,2})?$" ;
        sh:minCount 1 ;
        sh:message "amount must be a decimal string" ;
    ] ;
    sh:property [
        sh:path fabric:advertisementExists ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "advertisement must exist" ;
    ] ;
    sh:property [
        sh:path fabric:advertisementOpen ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "advertisement must be OPEN" ;
    ] .
