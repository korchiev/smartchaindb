ARG python_version=3.6
FROM python:${python_version}
LABEL maintainer "devs@bigchaindb.com"

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ \
    && pip install -U pip \
    && pip install pynacl \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ARG backend
ARG abci_status

ENV PYTHONUNBUFFERED 0
ENV PIP_DEFAULT_TIMEOUT=180
ENV PIP_RETRIES=15

ENV BIGCHAINDB_DATABASE_PORT 27017
ENV BIGCHAINDB_DATABASE_BACKEND $backend
ENV BIGCHAINDB_SERVER_BIND 0.0.0.0:9984
ENV BIGCHAINDB_WSSERVER_HOST 0.0.0.0
ENV BIGCHAINDB_WSSERVER_SCHEME ws

ENV BIGCHAINDB_WSSERVER_ADVERTISED_HOST 0.0.0.0
ENV BIGCHAINDB_WSSERVER_ADVERTISED_SCHEME ws

ENV BIGCHAINDB_TENDERMINT_PORT 26657

ENV BIGCHAINDB_CI_ABCI ${abci_status}

RUN mkdir -p /usr/src/app
COPY . /usr/src/app/
WORKDIR /usr/src/app
# Runtime extras only. `[dev]` pulls Sphinx/pytest and was dying on PyPI timeouts.
RUN pip install --retries 15 --default-timeout=180 -e .
RUN bigchaindb -l INFO -y configure
